- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\n\nimport numpy as np\n\
      from gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self,\
      \ window_size=10000):\n        gr.sync_block.__init__(\n            self,\n\
      \            name='BER for BPSK',\n            in_sig=[np.byte, np.byte],\n\
      \            out_sig=[np.float32]\n        )\n        self.window_size = int(window_size)\n\
      \        self.window = np.zeros(self.window_size, dtype=np.float32)\n      \
      \  self.win_ptr = 0\n\n    def work(self, input_items, output_items):\n    \
      \    ref = input_items[0].astype(np.int8)\n        rx  = input_items[1].astype(np.int8)\n\
      \n        n = min(len(ref), len(rx))\n\n        # For BPSK bits: error per symbol\
      \ is XOR (0 or 1)\n        errs = (ref[:n] ^ rx[:n]).astype(np.float32)\n\n\
      \        # cyclic queue update\n        for k in range(n):\n            self.window[self.win_ptr]\
      \ = errs[k]\n            self.win_ptr = (self.win_ptr + 1) % self.window_size\n\
      \n        BER = float(np.sum(self.window)) / float(self.window_size)\n\n   \
      \     # output BER for every produced sample (simple + compatible with sinks)\n\
      \        output_items[0][:n] = BER\n\n        return n\n"
    affinity: ''
    alias: ''
    comment: Block updated 2/14/2026
    maxoutbuf: '0'
    minoutbuf: '0'
    window_size: 1e5
  states:
    _io_cache: ('BER for BPSK', 'blk', [('window_size', '10000')], [('0', 'byte',
      1), ('1', 'byte', 1)], [('0', 'float', 1)], '', ['window_size'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [480, 408.0]
    rotation: 0
    state: enabled
- name: epy_block_0_0
  id: epy_block
  parameters:
    _source_code: "\"\"\"\nEmbedded Python Blocks:\n\nEach time this file is saved,\
      \ GRC will instantiate the first class it finds\nto get ports and parameters\
      \ of your block. The arguments to __init__  will\nbe the parameters. All of\
      \ them are required to have default values!\n\"\"\"\nimport numpy as np\nfrom\
      \ gnuradio import gr\n\nclass blk(gr.sync_block):\n    def __init__(self):\n\
      \        gr.sync_block.__init__(\n            self,\n            name='BPSK\
      \ Decoder',\n            in_sig=[np.complex64],\n            out_sig=[np.uint8]\n\
      \        )\n\n    def work(self, input_items, output_items):\n        x = input_items[0]\n\
      \        y = output_items[0]\n\n        # If real>=0 -> symbol 1, else symbol\
      \ 0\n        y[:] = (np.real(x) >= 0).astype(np.uint8)\n\n        return len(output_items[0])\n"
    affinity: ''
    alias: ''
    comment: Block updated 02/14/2026
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('BPSK Decoder', 'blk', [], [('0', 'complex', 1)], [('0', 'byte', 1)],
      '', [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 368.0]
    rotation: 0
    state: enabled
